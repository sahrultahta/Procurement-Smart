# Copy to .env and fill in, or let `npm run db:local -- init` generate .env for you.
# Never commit .env. Values below are placeholders.

# Runtime connection used by the app: the least-privilege role (ADR 0013).
DATABASE_URL=postgres://procureflow_app:CHANGE_ME@127.0.0.1:54318/procureflow_dev

# Connection used only by migrations: the schema owner role.
DATABASE_MIGRATION_URL=postgres://procureflow_owner:CHANGE_ME@127.0.0.1:54318/procureflow_dev

# Integration tests: owner-level server connection (creates one database per test file; needs CREATEDB)...
TEST_DATABASE_URL=postgres://procureflow_owner:CHANGE_ME@127.0.0.1:54318/postgres
# ...and the runtime role, so application code is tested with its real privileges.
TEST_APP_DATABASE_URL=postgres://procureflow_app:CHANGE_ME@127.0.0.1:54318/postgres

# Authentication (Better Auth). `npm run env:local` generates both for local development.
# The secret signs session cookies: at least 32 random characters, different per environment.
BETTER_AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# The public origin of the app. HTTPS here turns on Secure (__Secure-) cookies.
BETTER_AUTH_URL=http://localhost:3000

# Only for `npm run db:app-role` outside the local cluster: a role allowed to CREATE ROLE,
# and the password procureflow_app should get.
# DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# APP_DB_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARS

# Optional: debug | info | warn | error (default: info)
# LOG_LEVEL=info
