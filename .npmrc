# Supply-chain hardening (threat model E-04).
# Dependency lifecycle scripts never run. Native binaries come only from npm
# optional platform packages (e.g. @next/swc-*, @esbuild/*), never from
# install-time downloads. If a new dependency needs an install script,
# record that decision in the phase report.
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
