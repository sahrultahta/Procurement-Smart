{
  "name": "procureflow",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source procurement workflow system",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:local": "node scripts/db-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:app-role": "node scripts/db-app-role.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
